msgid "Missing dependencies"
msgstr "Faltan dependencias"

msgid "The following programs are not installed:"
msgstr "Los siguientes programas no están instalados:"

msgid "Please install them before running wl-color-picker."
msgstr "Instálelos antes de ejecutar wl-color-picker."

msgid "No Wayland session found."
msgstr "No se encontró ninguna sesión de Wayland."

msgid "This color picker must be run under a valid Wayland session."
msgstr "Este selector de color debe ejecutarse en una sesión de Wayland válida."

msgid "Select color"
msgstr "Seleccionar color"

msgid "Color copied to clipboard."
msgstr "Color copiado al portapapeles."

msgid "Saved colors"
msgstr "Colores guardados"

msgid "No saved colors."
msgstr "No hay colores guardados."

msgid "Select a saved color."
msgstr "Seleccionar un color guardado."

msgid "Color"
msgstr "Color"

msgid "Open"
msgstr "Abrir"

msgid "Delete"
msgstr "Eliminar"

msgid "Clear all"
msgstr "Borrar todo"

msgid "Close"
msgstr "Cerrar"

msgid "A simple color picker for Wayland/wlroots."
msgstr "Un sencillo selector de color para Wayland/wlroots."

msgid "Usage"
msgstr "Uso"

msgid "Commands"
msgstr "Comandos"

msgid "Select a color and copy it directly to the clipboard"
msgstr "Seleccionar un color y copiarlo directamente al portapapeles"

msgid "Show saved colors"
msgstr "Mostrar colores guardados"

msgid "Options"
msgstr "Opciones"

msgid "Don't show a system notification of copied color"
msgstr "No mostrar una notificación del sistema sobre el color copiado"

msgid "Show this help message"
msgstr "Mostrar este mensaje de ayuda"

msgid "WL Color Picker"
msgstr "Selector de color WL"

msgid "Choose an option:"
msgstr "Elija una opción:"

msgid "Option"
msgstr "Opción"

msgid "Pick a color"
msgstr "Seleccionar un color"

msgid "Select"
msgstr "Seleccionar"

msgid "Cancel"
msgstr "Cancelar"

msgid "Invalid command"
msgstr "Comando no válido"

msgid "Only one command can be specified."
msgstr "Solo se puede especificar un comando."

msgid "Invalid option"
msgstr "Opción no válida"

msgid "Unknown option:"
msgstr "Opción desconocida:"

msgid "Use --help to see available options."
msgstr "Use --help para ver las opciones disponibles."

msgid "wl-copy and notify-send are required to manage saved colors."
msgstr "Se necesitan wl-copy y notify-send para gestionar los colores guardados."

