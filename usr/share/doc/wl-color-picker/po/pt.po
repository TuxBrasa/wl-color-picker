msgid "Missing dependencies"
msgstr "Dependências ausentes"

msgid "The following programs are not installed:"
msgstr "Os seguintes programas não estão instalados:"

msgid "Please install them before running wl-color-picker."
msgstr "Instale-os antes de executar o wl-color-picker."

msgid "No Wayland session found."
msgstr "Nenhuma sessão Wayland encontrada."

msgid "This color picker must be run under a valid Wayland session."
msgstr "Este seletor de cores deve ser executado em uma sessão Wayland válida."

msgid "Select color"
msgstr "Selecionar cor"

msgid "Color copied to clipboard."
msgstr "Cor copiada para a área de transferência."

msgid "Saved colors"
msgstr "Cores salvas"

msgid "No saved colors."
msgstr "Nenhuma cor salva."

msgid "Select a saved color."
msgstr "Selecione uma cor salva."

msgid "Color"
msgstr "Cor"

msgid "Open"
msgstr "Abrir"

msgid "Delete"
msgstr "Excluir"

msgid "Clear all"
msgstr "Limpar tudo"

msgid "Close"
msgstr "Fechar"

msgid "A simple color picker for Wayland/wlroots."
msgstr "Um seletor de cores simples para Wayland/wlroots."

msgid "Usage"
msgstr "Uso"

msgid "Commands"
msgstr "Comandos"

msgid "Select a color and copy it directly to the clipboard"
msgstr "Selecionar uma cor e copiá-la diretamente para a área de transferência"

msgid "Show saved colors"
msgstr "Mostrar cores salvas"

msgid "Options"
msgstr "Opções"

