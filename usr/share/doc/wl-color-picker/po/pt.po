msgstr "Seletor de Cores WL"

msgid "Choose an option:"
msgstr "Escolha uma opção:"

msgid "Option"
msgstr "Opção"

msgid "Pick a color"
msgstr "Escolher uma cor"

msgid "Select"
msgstr "Selecionar"

msgid "Cancel"
msgstr "Cancelar"

msgid "Invalid command"
msgstr "Comando inválido"

msgid "Only one command can be specified."
msgstr "Somente um comando pode ser especificado."

msgid "Invalid option"
msgstr "Opção inválida"

msgid "Unknown option:"
msgstr "Opção desconhecida:"

msgid "Use --help to see available options."
msgstr "Use --help para ver as opções disponíveis."

msgid "wl-copy and notify-send are required to manage saved colors."
msgstr "wl-copy e notify-send são necessários para gerenciar as cores salvas."

