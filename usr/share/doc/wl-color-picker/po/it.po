msgid "Missing dependencies"
msgstr "Dipendenze mancanti"

msgid "The following programs are not installed:"
msgstr "I seguenti programmi non sono installati:"

msgid "Please install them before running wl-color-picker."
msgstr "Installali prima di eseguire wl-color-picker."

msgid "No Wayland session found."
msgstr "Nessuna sessione Wayland trovata."

msgid "This color picker must be run under a valid Wayland session."
msgstr "Questo selettore di colori deve essere eseguito in una sessione Wayland valida."

msgid "Select color"
msgstr "Seleziona colore"

msgid "Color copied to clipboard."
msgstr "Colore copiato negli appunti."

msgid "Saved colors"
msgstr "Colori salvati"

msgid "No saved colors."
msgstr "Nessun colore salvato."

msgid "Select a saved color."
msgstr "Seleziona un colore salvato."

msgid "Color"
msgstr "Colore"

msgid "Open"
msgstr "Apri"

msgid "Delete"
msgstr "Elimina"

msgid "Clear all"
msgstr "Cancella tutto"

msgid "Close"
msgstr "Chiudi"

msgid "A simple color picker for Wayland/wlroots."
msgstr "Un semplice selettore di colori per Wayland/wlroots."

msgid "Usage"
msgstr "Utilizzo"

msgid "Commands"
msgstr "Comandi"

msgid "Select a color and copy it directly to the clipboard"
msgstr "Seleziona un colore e copialo direttamente negli appunti"

msgid "Show saved colors"
msgstr "Mostra colori salvati"

msgid "Options"
msgstr "Opzioni"

msgid "Don't show a system notification of copied color"
msgstr "Non mostrare una notifica di sistema per il colore copiato"

msgid "Show this help message"
msgstr "Mostra questo messaggio di aiuto"

msgid "WL Color Picker"
msgstr "Selettore di colori WL"

msgid "Choose an option:"
msgstr "Scegli un'opzione:"

msgid "Option"
msgstr "Opzione"

msgid "Pick a color"
msgstr "Scegli un colore"

msgid "Select"
msgstr "Seleziona"

msgid "Cancel"
msgstr "Annulla"

msgid "Invalid command"
msgstr "Comando non valido"

msgid "Only one command can be specified."
msgstr "È possibile specificare un solo comando."

msgid "Invalid option"
msgstr "Opzione non valida"

msgid "Unknown option:"
msgstr "Opzione sconosciuta:"

msgid "Use --help to see available options."
msgstr "Usa --help per visualizzare le opzioni disponibili."

msgid "wl-copy and notify-send are required to manage saved colors."
msgstr "Sono necessari wl-copy e notify-send per gestire i colori salvati."

